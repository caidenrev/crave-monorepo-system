# ==============================================================================
# CRAVE EVENT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Project Credentials (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# (Opsional) Backend Server Secret Key
# SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
# DATABASE_PASSWORD=your_database_password_here

# Mode
VITE_BACKEND_MODE=supabase

# ============================================================================
# PAYMENTGT (Crave Payment Services) — KRUSIAL UNTUK REALTIME PAYMENT STATUS
# ============================================================================
# URL gateway serverless Go (default ke deployment Vercel crave-payment-services)
VITE_PAYMENTGT_URL=https://crave-payment-services-57oz.vercel.app

# Session JSON merchant ShopeePay untuk pembayaran tiket event.
# WAJIB diisi agar gateway dapat mengecek mutasi ShopeePay secara realtime
# dan mendeteksi status PAID. Tanpa ini, payment status tidak akan pernah
# realtime berhasil (bug setelah merge crave-event dengan pos-system).
#
# Cara mendapatkan session_json:
# 1. Login sebagai merchant di pos-system > menu Pengaturan > QRIS Merchant
#    > ikuti flow OTP Shopee. Session otomatis tersimpan ke tabel merchant_settings.
# 2. Jika user yang beli tiket di crave-event adalah merchant yang sama (akun sama),
#    session_json akan otomatis diambil dari tabel merchant_settings.
# 3. Jika user adalah peserta biasa (BUKAN merchant), set env ini dengan nilai
#    session_json merchant PENYELENGGARA event. Ambil dari tabel merchant_settings
#    admin, atau export dari pos-system Pengaturan.
VITE_PAYMENTGT_SESSION_JSON=

# (Opsional) String QRIS statis merchant default untuk fallback.
VITE_PAYMENTGT_STATIC_QRIS=
