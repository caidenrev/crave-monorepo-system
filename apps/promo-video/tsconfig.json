{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["react", "react-dom"],
    "paths": { "@/*": ["../pos-system/src/*"] }
  },
  "include": ["src", "remotion.config.ts", "../pos-system/src/vite-env.d.ts"]
}
