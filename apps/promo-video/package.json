{
  "name": "promo-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion preview",
    "video:preview": "remotion preview",
    "preview": "remotion preview",
    "build": "remotion render src/index.ts CravePromoVertical out/crave-promo-vertical.mp4",
    "render": "remotion render src/index.ts CravePromoVertical out/crave-promo-vertical.mp4",
    "render:vertical": "remotion render src/index.ts CravePromoVertical out/crave-promo-vertical.mp4",
    "video:render": "remotion render src/index.ts CravePromoVertical out/crave-promo-vertical.mp4",
    "render:landscape": "remotion render src/index.ts CravePromoLandscape out/crave-promo-landscape.mp4",
    "video:render:landscape": "remotion render src/index.ts CravePromoLandscape out/crave-promo-landscape.mp4",
    "render:all": "npm run render:vertical && npm run render:landscape"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.260",
    "@remotion/cli": "^4.0.260",
    "@remotion/motion-blur": "^4.0.532",
    "@remotion/shapes": "^4.0.260",
    "@remotion/transitions": "^4.0.532",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.260",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@remotion/tailwind": "^4.0.260",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
